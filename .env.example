# Ethereum Mainnet RPC URL
# Required for all tests
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Optional: Base RPC for thirdweb reverse-l2 (defaults to https://mainnet.base.org)
# BASE_RPC_URL=https://mainnet.base.org

# Optional: thirdweb credentials (https://thirdweb.com/create-api-key)
# Only needed if you rely on thirdweb gateway RPCs instead of RPC_URL / BASE_RPC_URL
# THIRDWEB_SECRET_KEY=
# THIRDWEB_CLIENT_ID=
